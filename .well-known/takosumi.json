{
  "apiVersion": "takosumi.com/v2.5",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "public_subdomain",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "公開サブドメイン",
              "en": "Public subdomain"
            },
            "advanced": true
          },
          {
            "name": "public_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は利用可能なWorker URLを使います。",
              "en": "Uses an available Worker URL when omitted."
            },
            "placeholder": "https://storage.example.com"
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Workerリリース",
              "en": "Worker release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Worker URL",
              "en": "Worker URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Worker SHA-256",
              "en": "Worker SHA-256"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts URL",
              "en": "Takosumi Accounts URL"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_redirect_uri",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Registered callback URI",
              "en": "Registered callback URI"
            },
            "advanced": true
          },
          {
            "name": "takosumi_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "アプリID",
              "en": "App ID"
            }
          },
          {
            "name": "takosumi_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "互換Workspace ID",
              "en": "Compatibility Workspace ID"
            }
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "public_url",
                "subdomain": "public_subdomain"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": ["openid", "profile", "email"],
            "deliver": {
              "variables": {
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "accountsUrl": "takosumi_accounts_url",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos-storage.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos Storage"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["ui.open"],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          },
          {
            "key": "object",
            "name": "takos-storage.object",
            "spec": {
              "type": "storage.object",
              "version": "1",
              "document": {
                "protocol": "http.object",
                "display": {
                  "title": "Takos Storage Object API"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "api_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            }
          },
          {
            "key": "mcp",
            "name": "takos-storage.mcp",
            "spec": {
              "type": "mcp.server",
              "version": "2025-11-25",
              "document": {
                "transport": "streamable-http",
                "display": {
                  "title": "Takos Storage"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "mcp_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["mcp.invoke"],
                "delivery": {
                  "type": "oauth2"
                }
              }
            ]
          }
        ]
      },
      "deploy/takoform": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "takosumi_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "アプリID",
              "en": "App ID"
            }
          },
          {
            "name": "takosumi_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "互換Workspace ID",
              "en": "Compatibility Workspace ID"
            }
          }
        ],
        "requires": [
          {
            "kind": "secret.generated",
            "bytes": 32,
            "encoding": "hex",
            "deliver": {
              "bindings": {
                "value": "APP_SESSION_SECRET"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": ["openid", "profile", "email"],
            "deliver": {
              "bindings": {
                "issuerUrl": "OIDC_ISSUER_URL",
                "clientId": "OIDC_CLIENT_ID",
                "ownerSubject": "OIDC_OWNER_SUB",
                "redirectUri": "OIDC_REDIRECT_URI"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos-storage.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos Storage"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["ui.open"],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          },
          {
            "key": "object",
            "name": "takos-storage.object",
            "spec": {
              "type": "storage.object",
              "version": "1",
              "document": {
                "protocol": "http.object",
                "display": {
                  "title": "Takos Storage Object API"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "api_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            }
          },
          {
            "key": "mcp",
            "name": "takos-storage.mcp",
            "spec": {
              "type": "mcp.server",
              "version": "2025-11-25",
              "document": {
                "transport": "streamable-http",
                "display": {
                  "title": "Takos Storage"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "mcp_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["mcp.invoke"],
                "delivery": {
                  "type": "oauth2"
                }
              }
            ]
          }
        ],
        "sourceBuild": {
          "commands": [
            {
              "argv": ["bun", "install", "--frozen-lockfile"]
            },
            {
              "argv": ["bun", "run", "build:worker"]
            }
          ],
          "outputs": ["dist/worker.js"]
        }
      }
    }
  }
}
